    \"title\": \"Beating the Curse of Dimensionality in Optimal Stopping\",\n    \"url\": \"https://arxiv.org/abs/1807.02227\",\n    \"authors\": \"David A. Goldberg\",\n    \"year\": 2018,\n    \"bucket\": \"Preprint\",\n    \"rank\": 6,\n    \"status\": \"Under revision.\",\n    \"awards\": [\n      {\"type\": \"award\", \"text\": \"First Place, 2019 INFORMS Nicholson Student Paper Competition\"},\n      {\"type\": \"award\", \"text\": \"Finalist, 2018 INFORMS Section on Finance Student Best Paper Award\"}\n    ],\n    \"teaser\": \"Greedy policies create heavy-tailed match distances due to local supply-demand drift.\",\n    \"abstract\": \"Using coupling and tail bounds, we show that locally myopic matching induces heavy tails...\",\n    \"topics\": [\"sequential decisions\"]\n  },\n  {\n    \"title\": \"Online Stochastic Packing with General Correlations\",\n    \"url\": \"https://arxiv.org/abs/2508.13458\",\n    \"authors\": \"Sabri Cetin and David A. Goldberg\",\n    \"year\": 2025,\n    \"bucket\": \"Preprint\",\n    \"rank\": 3,\n    \"status\": \"Under review.\",\n    \"teaser\": \"We design ZK protocols to verify OLS statistics without revealing raw data.\",\n    \"abstract\": \"We propose succinct ZK circuits for common econometric tests...\",\n    \"topics\": [\"sequential decisions\"]\n  },\n  {\n    \"title\": \"Incentivizing Resource Pooling\",\n    \"url\": \"https://papers.ssrn.com/sol3/papers.cfm?abstract_id=4586771\",\n    \"authors\": \"Chen Chen and Pengyu Qian\",\n    \"year\": 2025,\n    \"bucket\": \"Published\",\n    \"rank\": 1,\n    \"status\": \"<i><b>Management Science</b></i>, forthcoming.\",\n    \"awards\": [\n      {\"type\": \"award\", \"text\": \"First Place, 2024 INFORMS JFIG Best Paper Competition\"},\n      {\"type\": \"award\", \"text\": \"First Prize, 2024 CSAMSE Best Paper Award\"},\n      {\"type\": \"other\", \"text\": \"Presentation at MSOM Service Management SIG 2024\"},\n      {\"type\": \"other\", \"text\": \"Preliminary version in ACM EC'24 <a href='https://dl.acm.org/doi/10.1145/3670865.3673450'>[link]</a>\"}\n    ],\n    \"teaser\": \"A Stackelberg platform uses price and allocation rules to shift demand while respecting supply constraints.\",\n    \"abstract\": \"We model platform-driven demand shifting and derive implementable mechanisms...\",\n    \"topics\": [\"platform\"]\n  },\n  {\n    \"title\": \"Feature-Based Dynamic Matching\",\n    \"url\": \"https://papers.ssrn.com/sol3/papers.cfm?abstract_id=4451799\",\n    \"authors\": \"Yash Kanoria, Akshit Kumar and Wenxin Zhang\",\n    \"year\": 2025,\n    \"bucket\": \"Published\",\n    \"rank\": 2,\n    \"status\": \"<i><b>Operations Research</b></i>, forthcoming.\",\n    \"awards\": [\n      {\"type\": \"award\", \"text\": \"First Place, 2024 INFORMS RMP Jeff McGill Student Paper Competition (awarded to Akshit Kumar)\"},\n      {\"type\": \"other\", \"text\": \"Preliminary version in ACM EC'23 <a href='https://dl.acm.org/doi/10.1145/3580507.3597797'>[link]</a>\"}\n    ],\n    \"teaser\": \"A Stackelberg platform uses price and allocation rules...\",\n    \"abstract\": \"We model platform-driven demand shifting and derive implementable mechanisms...\",\n    \"topics\": [\"sequential decisions\"]\n  }\n]\n</script>\n\n<!-- ========= RENDER SCRIPT: By Date + By Topic (same card format) ========= -->\n<script>\nwindow.addEventListener('DOMContentLoaded', () => {\n  const THEMES = [{\n    id: \"sequential decisions\",\n    label: \"Efficient Algorithms for Sequential Decision-Making\",\n    desc: \"...\"\n  },\n  {\n    id: \"platform\",\n    label: \"Algorithm and Mechanism Design for Platforms\",\n    desc: \"...\"\n  } ]; // ← edit to 2–3 blocks you want\n  const OTHER_LABEL = \"Other\";\n\n  const dataEl = document.getElementById('papers-data');\n  const PAPERS = JSON.parse((dataEl?.textContent || '[]').trim());\n\n  // Switcher elements\n  const byDateWrap  = document.getElementById('view-by-date');\n  const byTopicWrap = document.getElementById('view-by-topic');\n  const btnDate  = document.getElementById('btn-date');\n  const btnTopic = document.getElementById('btn-topic');\n\n  // Helpers\n  function inferBucket(status) {\n    const s = (status || '').toLowerCase();\n    return (s.includes('published') || s.startsWith('forthcoming') || s.startsWith('accepted') || s.includes('conditionally accepted'))\n      ? 'Published' : 'Preprint';\n  }\n\n  // Sort by year (desc), then rank (asc if provided), then title\n  const byYear = (a, b) => {\n    if (b.year !== a.year) return b.year - a.year;\n    if (a.rank !== undefined && b.rank !== undefined) return a.rank - b.rank;\n    if (a.rank !== undefined) return -1;\n    if (b.rank !== undefined) return 1;\n    return a.title.localeCompare(b.title);\n  };\n\n  // One paper entry (your existing compact format)\n  function liFor(p){\n    const li = document.createElement('li');\n    li.className = 'paper';\n\n    const titleP = document.createElement('p');\n    titleP.className = 'title';\n    const a = document.createElement('a');\n    a.href = p.url || '#';\n    a.target = '_blank';\n    a.textContent = p.title;\n    titleP.appendChild(a);\n    if (p.authors && p.authors.trim()) {\n      const spanAuth = document.createElement('span');\n      spanAuth.className = 'authors-after';\n      spanAuth.textContent = ` (with ${p.authors})`;\n      titleP.appendChild(spanAuth);\n    }\n    li.appendChild(titleP);\n\n    if (p.status && p.status.trim()) {\n      const st = document.createElement('div');\n      st.className = 'status-line';\n      st.innerHTML = (p.status || '').replace(/\\n/g, '<br>');\n      li.appendChild(st);\n    }\n\n    // Awards (two types, support object/strings; allow HTML links)\n    if (p.awards && p.awards.length) {\n      const wrap = document.createElement('div');\n      wrap.className = 'awards-wrap';\n      const ul = document.createElement('ul');\n      ul.className = 'awards-list';\n\n      const norm = (item) => {\n        if (typeof item === 'string') {\n          const s = item.trim();\n          if (s.toLowerCase().startsWith('award:')) return { type:'award', text:s.slice(6).trim() };\n          if (s.toLowerCase().startsWith('other:')) return { type:'other', text:s.slice(6).trim() };\n          return { type:'award', text:s };\n        }\n        return { type: (item.type||'award').toLowerCase(), text: item.text || '' };\n      };\n\n      (p.awards || []).map(norm).forEach(({type, text})=>{\n        if (!text) return;\n        const liw = document.createElement('li');\n        liw.className = 'award-item ' + (type === 'other' ? 'other' : 'award');\n        liw.innerHTML = text;\n        ul.appendChild(liw);\n      });\n\n      wrap.appendChild(ul);\n      li.appendChild(wrap);\n    }\n\n    const teaserP = document.createElement('p');\n    teaserP.className = 'teaser';\n    const spanTeaser = document.createElement('span');\n    spanTeaser.className = 'teaser-text';\n    spanTeaser.textContent = p.teaser || '';\n    teaserP.appendChild(spanTeaser);\n\n    if (p.abstract && p.abstract.trim()) {\n      const more = document.createElement('button');\n      more.className = 'more-btn';\n      more.type = 'button';\n      more.textContent = '[more]';\n      teaserP.appendChild(more);\n\n      const absP = document.createElement('p');\n      absP.className = 'abstract hidden';\n      absP.textContent = (p.abstract || '') + ' ';\n      const lessBtn = document.createElement('button');\n      lessBtn.className = 'less-btn';\n      lessBtn.type = 'button';\n      lessBtn.textContent = '[less]';\n      absP.appendChild(lessBtn);\n\n      more.addEventListener('click', () => {\n        spanTeaser.classList.add('hidden');\n        more.classList.add('hidden');\n        absP.classList.remove('hidden');\n      });\n      lessBtn.addEventListener('click', () => {\n        absP.classList.add('hidden');\n        spanTeaser.classList.remove('hidden');\n        more.classList.remove('hidden');\n      });\n\n      li.appendChild(teaserP);\n      li.appendChild(absP);\n    } else {\n      li.appendChild(teaserP);\n    }\n\n    return li;\n  }\n\n  // ===== Render: BY DATE =====\n  (function renderByDate(){\n    const ulPre = document.getElementById('pub-preprint');\n    const ulPub = document.getElementById('pub-published');\n    ulPre.innerHTML = ''; ulPub.innerHTML = '';\n\n    const preprint = [], published = [];\n    PAPERS.forEach(p => {\n      const b = (p.bucket || '').trim();\n      const bucket = (b ? b : inferBucket(p.status));\n      (bucket.toLowerCase().startsWith('pub') || bucket.toLowerCase().startsWith('acc') ? published : preprint).push(p);\n    });\n\n    preprint.sort(byYear);\n    published.sort(byYear);\n\n    preprint.forEach(p => ulPre.appendChild(liFor(p)));\n    published.forEach(p => ulPub.appendChild(liFor(p)));\n  })();\n\n  // ===== Render: BY TOPIC =====\n  // ------- Theme matching helpers (case-insensitive) -------\nconst NORM = s => (s || '').trim().toLowerCase();\nconst THEME_IDS      = THEMES.map(t => t.id);\nconst THEME_IDS_LOWER= THEMES.map(t => NORM(t.id));\nconst THEME_META     = Object.fromEntries(THEMES.map(t => [t.id, t]));\n\nfunction canonicalThemeId(s) {\n  const idx = THEME_IDS_LOWER.indexOf(NORM(s));\n  return idx >= 0 ? THEME_IDS[idx] : null; // return canonical cased id\n}\n\nfunction themeOf(p) {\n  // Prefer explicit \"theme\"\n  if (p.theme) {\n    const canon = canonicalThemeId(p.theme);\n    if (canon) return canon;\n  }\n  // Then scan \"topics\" array\n  const topics = Array.isArray(p.topics) ? p.topics : [];\n  for (const t of topics) {\n    const canon = canonicalThemeId(t);\n    if (canon) return canon;\n  }\n  return OTHER_LABEL;\n}\n\n// ------- Render: BY TOPIC -------\n(function renderByTopic(){\n  const wrap = byTopicWrap;\n  wrap.innerHTML = '';\n  const buckets = {};\n\n  PAPERS.forEach(p => {\n    const k = themeOf(p);\n    (buckets[k] ||= []).push(p);\n  });\n\n  // Order: all defined THEMES (by id), then \"Other\" if present\n  const order = THEME_IDS.slice();\n  if (buckets[OTHER_LABEL]?.length) order.push(OTHER_LABEL);\n\n  order.forEach(id => {\n    const arr = (buckets[id] || []).slice().sort(byYear);\n    if (!arr.length) return;\n\n    const meta = THEME_META[id];\n\n    // Header\n    const h = document.createElement('div');\n    h.className = 'topic-title';\n    h.dataset.topic = id;                // allows per-topic CSS, if desired\n    h.textContent = meta ? meta.label : id;\n    wrap.appendChild(h);\n\n    // Optional description\n    if (meta?.desc) {\n      const desc = document.createElement('div');\n      desc.className = 'topic-desc';\n      desc.textContent = meta.desc;\n      wrap.appendChild(desc);\n    }\n\n    // List\n    const ul = document.createElement('ul');\n    ul.className = 'pubs';\n    arr.forEach(p => ul.appendChild(liFor(p)));\n    wrap.appendChild(ul);\n  });\n})();\n\n  \n\n  // ===== Switch behavior =====\n  function activate(which){\n    const isDate = (which === 'date');\n    byDateWrap.classList.toggle('hidden', !isDate);\n    byTopicWrap.classList.toggle('hidden', isDate);\n    btnDate.classList.toggle('active', isDate);\n    btnTopic.classList.toggle('active', !isDate);\n    btnDate.setAttribute('aria-selected', String(isDate));\n    btnTopic.setAttribute('aria-selected', String(!isDate));\n  }\n  btnDate.addEventListener('click', ()=>activate('date'));\n  btnTopic.addEventListener('click',()=>activate('topic'));\n});\n</script>"},"formats":{"html":{"identifier":{"display-name":"HTML","target-format":"html","base-format":"html"},"execute":{"fig-width":7,"fig-height":5,"fig-format":"retina","fig-dpi":96,"df-print":"default","error":false,"eval":true,"cache":null,"freeze":false,"echo":true,"output":true,"warning":true,"include":true,"keep-md":false,"keep-ipynb":false,"ipynb":null,"enabled":null,"daemon":null,"daemon-restart":false,"debug":false,"ipynb-filters":[],"ipynb-shell-interactivity":null,"plotly-connected":true,"engine":"markdown"},"render":{"keep-tex":false,"keep-typ":false,"keep-source":false,"keep-hidden":false,"prefer-html":false,"output-divs":true,"output-ext":"html","fig-align":"default","fig-pos":null,"fig-env":null,"code-fold":"none","code-overflow":"scroll","code-link":false,"code-line-numbers":false,"code-tools":false,"tbl-colwidths":"auto","merge-includes":true,"inline-includes":false,"preserve-yaml":false,"latex-auto-mk":true,"latex-auto-install":true,"latex-clean":true,"latex-min-runs":1,"latex-max-runs":10,"latex-makeindex":"makeindex","latex-makeindex-opts":[],"latex-tlmgr-opts":[],"latex-input-paths":[],"latex-output-dir":null,"link-external-icon":false,"link-external-newwindow":false,"self-contained-math":false,"format-resources":[],"notebook-links":true},"pandoc":{"standalone":true,"wrap":"none","default-image-extension":"png","to":"html","css":["styles.css"],"include-in-header":{"text":"<style>\n  /* ===== Minimal, tight layout ===== */\n  .sec {\n    font-size: 1rem; font-weight: 500; color: #333;\n    margin: 1rem 0 0.35rem; padding-top: 0.6rem;\n    border-top: 1px solid #e6e6e6;\n  }\n\n  .pubs { list-style: none; padding: 0; margin: 1rem 0rem 0rem 2rem; }\n  .paper  { margin: 0 0 0.8rem 0;\n  line-height: 1.45;\n        }\n\n  /* Title line: bold-ish blue title + authors inline */\n  .title { margin: 0; line-height: 1.3; }\n  .title a { color: #0b4bb3; font-weight: 500; text-decoration: none; }\n  .title a:hover { text-decoration: underline; }\n  .authors-after { color: #333; font-weight: 400; margin-left: 6px; }\n\n  /* Status: free-form (multi-line), own line */\n  .status-line { color: #555; margin: 2px 0 0; font-size: 0.92em; white-space: pre-wrap; }\n\n  /* Awards — two types: award vs other */\n  .awards-wrap { margin: 2px 0 0; font-size: 0.92em; }\n  .awards-list { margin: 0.15rem 0 0; padding-left: 1.1rem; font-size: 0.92rem; }\n  .awards-list li { margin: 0; }\n  .award-item.award { color: rgb(164,143,86); font-weight: 500; }\n  .award-item.other { color: #444; }\n  .awards-list a { color:#0b4bb3; text-decoration:none; }\n  .awards-list a:hover { text-decoration:none; }\n\n  /* Teaser + [more]/[less] inline */\n  .teaser { margin: 2px 0 0; color: #6f6f6f; font-size: .92rem; }\n  .teaser-text { display: inline; }\n  .more-btn, .less-btn { display:inline; margin-left:6px; border:0; background:none; color:#0b4bb3; cursor:pointer; padding:0; font-size:.92rem; }\n  .more-btn:hover, .less-btn:hover { text-decoration: underline; }\n  .abstract { margin: 4px 0 0; color: #333; }\n  .hidden { display: none; }\n\n  /* Indent sub-lines under the title */\n  .paper > .status-line, .paper > .awards-wrap, .paper > .teaser, .paper > .abstract { margin-left: 1.2em; }\n\n  /* ===== Switcher UI ===== */\n  .switcher { display:flex; gap:.5rem; align-items:center; margin:.6rem 0 .2rem 0; }\n  .switch-btn {\n    padding: .35rem .6rem; border: 1px solid #e1e1e1; background:#fafafa; cursor:pointer; border-radius: 8px; font-size:.92rem;\n  }\n  .switch-btn.active { background:#eff5ff; border-color:#cbdcf8; color:#174ea6; }\n\n  /* Topic block heading matches your small section-title look */\n  .topic-title {   font-family: \"Montserrat\", sans-serif;\n  font-size: 1.5rem; font-weight: 500; color: #333;\n  margin: 1rem 0 0.35rem; padding-top: 0.6rem; border-top: 1px solid #e6e6e6; }\n</style>\n"},"toc":false,"output-file":"publication.html"},"language":{"toc-title-document":"Table of contents","toc-title-website":"On this page","related-formats-title":"Other Formats","related-notebooks-title":"Notebooks","source-notebooks-prefix":"Source","other-links-title":"Other Links","code-links-title":"Code Links","launch-dev-container-title":"Launch Dev Container","launch-binder-title":"Launch Binder","article-notebook-label":"Article Notebook","notebook-preview-download":"Download Notebook","notebook-preview-download-src":"Download Source","notebook-preview-back":"Back to Article","manuscript-meca-bundle":"MECA Bundle","se